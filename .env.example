# Migrator role: owns the schema, runs drizzle-kit migrations.
DATABASE_URL=postgresql://ballroomdash_migrator:ballroomdash_migrator@localhost:5432/ballroomdash

# Runtime role: least-privilege, used by the app's connection pool.
# Created by scripts/db-setup-roles.sql — never give this role DDL rights.
DATABASE_RUNTIME_URL=postgresql://app_runtime:app_runtime@localhost:5432/ballroomdash

# Local setup run order:
# 1. docker compose up -d
# 2. psql $DATABASE_URL -c "CREATE DATABASE ballroomdash;" if Compose didn't already
#    create it (Compose's POSTGRES_DB env var handles this on first boot).
# 3. npx drizzle-kit migrate (runs drizzle/0000_*.sql and 0001_tenant_probe_rls.sql,
#    as the migrator role — creates schema "app" before the roles script needs to
#    grant on it).
# 4. psql $DATABASE_URL -f scripts/db-setup-roles.sql (creates app_runtime, grants
#    USAGE on both schemas now that they exist).
